BuddyConfigDialog {
    align: center middle;
    background: $background 40%;
}

/* 84 wide and 32 tall: the Appearance tab's portrait preview plus its six rows
   need ~36 rows, which the pane scrolls; the extra height shows the preview and
   most rows at once, plus the tab bar and the two-row border the title needs.
   The border, its title and its subtitle live here, as on the other dialogs,
   and the button row docks inside this box so the frame encloses it. */
#buddy-config-container {
    width: 84;
    height: 32;
    border: round $tui-border-primary $border-opacity;
    border-title-color: $primary;
    border-title-style: bold;
    background: $surface;
    padding: 0;
}

#buddy-config-tabs {
    height: 1fr;
}

#buddy-config-tabs ContentSwitcher {
    height: 1fr;
}

#buddy-config-tabs TabPane {
    height: 1fr;
    padding: 0;
}
